# 10RemoteHub least-privilege udev rules for Linux desktop sessions.
# Grants ACL access ONLY to the supported 0416:0602 USB receiver and uinput
# for the currently active local login seat (via systemd-logind uaccess).
# Never exposes unrelated physical keyboards.
#
# Install:
#   sudo install -m 0644 70-10remotehub.rules /etc/udev/rules.d/70-10remotehub.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="0602", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="0602", MODE="0660", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", MODE="0660", TAG+="uaccess"
